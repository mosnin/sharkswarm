# ── LLM API Keys ──────────────────────────────────────────────
OPENAI_API_KEY=sk-REPLACE_ME

# ── Model (optional, defaults to gpt-4.1-mini) ─────────────────
OPENAI_MODEL=gpt-4.1-mini

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_DB=nanoclaw
POSTGRES_USER=nanoclaw
POSTGRES_PASSWORD=changeme

# ── API Gateway ──────────────────────────────────────────────
# Allowed frontend origin (set to your Vercel URL in production)
CORS_ORIGIN=https://agentfrac.com

# ── Cloudflare Tunnel ───────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── Derived (used by app containers — no need to edit) ────────
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://nanoclaw:changeme@postgres:5432/nanoclaw
